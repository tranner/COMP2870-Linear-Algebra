{
    "text-color": "#1A1A1A",
    "background-color": "#F0EBDD",
    "line-number-color": "#4A4A4A",
    "line-number-background-color": null,
    "text-styles": {
        "Keyword":        { "text-color": "#004C77", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#004C77", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#004C77", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "String":         { "text-color": "#00543D", "background-color": null, "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#00543D", "background-color": null, "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#00543D", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#00543D", "background-color": null, "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#00543D", "background-color": null, "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#793600", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#793600", "background-color": null, "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#793600", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#793600", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#782E57", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#782E57", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#782E57", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#782E57", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Information":    { "text-color": "#782E57", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Warning":        { "text-color": "#782E57", "background-color": null, "bold": true,  "italic": true,  "underline": false },
        "Alert":          { "text-color": "#793600", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Error":          { "text-color": "#793600", "background-color": null, "bold": true,  "italic": false, "underline": true },
        "Preprocessor":   { "text-color": "#1A1A1A", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#1A1A1A", "background-color": null, "bold": false, "italic": false, "underline": false }
    }
}
